import java.util.Scanner;
public class Main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int []arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
    int max=0;
        for(int i=0;i<n;i++){
            for(int j=n-1;j>0;j--){
                if(arr[j]==arr[i]){
                    int val=j-i+1;
                    if(val>max){
                        max=val;
                    }
                    break;
                }

            }
        }
        System.out.println(max);
    }
}
