import java.util.Scanner;
public class Main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int []arr1=new int[n];
       
        for(int i=0;i<n;i++){
            arr1[i]=sc.nextInt();
        }
        int[]arr2=new int[n];
        for(int i=0;i<n;i++){
            arr2[i]=sc.nextInt();
        }
         int count=0;
         int i=0;
         int j=0;
        while(i<n && j<n){
            if(arr1[i]>arr2[j]){
                count++;
                i++;
                j++;
            }
            else{
                i++;
            }
        }
    System.out.println(count);
    }
}
