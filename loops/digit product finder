
import java.util.Scanner;
public class Main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        int count=0;
         if(n<10){
                System.out.print(count+" ");
                System.out.println(n);
                return;}
        while(n>0){
            long temp=n;
            long sum=1;
            while(temp>0){
                long d=temp%10;
                sum=sum*d;
                temp=temp/10;
            }
            count++;
            if(sum<10){
                System.out.print(count+" ");
                System.out.println(sum);
                return;
            }
            else{
                n=sum;
            }
        }
    }
}
